# ═══════════════════════════════════════════════════════════
# GARP Tracker — Environment Variables (example)
# Copy to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ── Server ──
PORT=3000
JWT_SECRET=your-secret-key-here
DATA_DIR=./data

# ── Session ──
ATTENDANCE_CUTOFF=10:00

# ── Web Push (VAPID) — generate with: npx web-push generate-vapid-keys ──
VAPID_PUBLIC=
VAPID_PRIVATE=

# ── Email (Resend — primary) ──
RESEND_API_KEY=re_xxxxxxxx
MAIL_FROM=GARP & Associates <noreply@yourdomain.com>

# ── Email (SMTP — legacy fallback, used if RESEND_API_KEY is not set) ──
SMTP_USER=office@yourdomain.com
SMTP_PASS=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── SMS (Fast2SMS) ──
FAST2SMS_API_KEY=your-fast2sms-key
FAST2SMS_SENDER_ID=YOURID
FAST2SMS_ROUTE=dlt

# ── WhatsApp (Meta Cloud API) ──
WA_TOKEN=your-whatsapp-token
WA_PHONE_ID=your-phone-number-id
WA_API_VERSION=v20.0
WA_TEMPLATE_LANG=en
WA_TEMPLATE_STAGE=itr_status_update

# ── Android TWA (Play Store) ──
ANDROID_PACKAGE=com.your.package
ANDROID_SHA256=AA:BB:CC:...

# Local development only. NEVER put backend secrets (JWT_SECRET, SMTP_PASS,
# WA_TOKEN, DB credentials) in the mobile app — it ships to devices.
#
# Android emulator reaches the host machine on 10.0.2.2.
# Physical device on the same Wi-Fi: use your machine's LAN IP, e.g. http://192.168.1.5:3000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
